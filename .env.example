# Root env untuk docker compose (VPS). Copy ke .env di root repo, JANGAN commit.
# PASSWORD DB di sini HARUS sama dengan DATABASE_URL.
DATABASE_URL=postgresql+asyncpg://mte:GANTI_PASSWORD_DB@db:5432/mte
POSTGRES_USER=mte
POSTGRES_PASSWORD=GANTI_PASSWORD_DB
POSTGRES_DB=mte
MAX_UPLOAD_MB=50
JWT_SECRET=GANTI_MIN_32_KARAKTER_ACAK
JWT_EXP_MIN=60
JWT_REFRESH_DAYS=7
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GANTI_PASSWORD_ADMIN
